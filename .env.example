# Skopiuj ten plik jako .env i wpisz prawdziwe wartości z panelu Supabase.
# (.env jest w .gitignore i NIE trafia do gita)
#
# Supabase Dashboard → Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard → Settings → API Keys → Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Mapbox → Account → Tokens → Default public token (pk....)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx

# Google Cloud → APIs & Services → Places API (włącz) → Credentials → API key
# Ogranicz klucz do Places API. Bez tego klucza nazwy z Google Maps nie będą się pobierać.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Web Push (VAPID) — klucz PUBLICZNY, bezpieczny do ujawnienia w kliencie.
# Wygenerowany raz dla projektu, patrz scripts/generate-vapid-keys.mjs.
# Klucz PRYWATNY (VAPID_PRIVATE_KEY) NIE trafia tutaj — żyje wyłącznie jako
# sekret Supabase Edge Function (supabase secrets set).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Opcjonalnie — automatyczne wgranie chunków OSM (scripts/osm-poland/upload-via-mcp.mjs)
# Supabase Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=gjkbnkaijlempveotnui
